/* ============================================
   Ben Westlund — shared styles
   ============================================ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --navy:#12172B;
  --navy-2:#1B2140;
  --paper:#F7F6F3;
  --white:#FFFFFF;
  --cobalt:#3355FF;
  --cobalt-soft:#E7ECFF;
  --coral:#FF6B4A;
  --coral-soft:#FFEAE3;
  --slate:#6B7086;
  --line:#E4E3DE;
  --display:'Space Grotesk',sans-serif;
  --body:'Inter',system-ui,sans-serif;
  --mono:'IBM Plex Mono',monospace;
}
html{scroll-behavior:smooth;}
body{
  background:var(--paper);color:var(--navy);
  font-family:var(--body);font-size:16px;line-height:1.6;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;
}
a{color:inherit;}
img{max-width:100%;display:block;}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;}}
:focus-visible{outline:2px solid var(--cobalt);outline-offset:3px;}

/* NAV */
nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  display:flex;align-items:center;justify-content:space-between;
  padding:1.1rem 2.75rem;
  background:rgba(247,246,243,0.88);
  backdrop-filter:blur(10px);border-bottom:1px solid var(--line);
}
.nav-mark{display:flex;align-items:center;gap:0.55rem;text-decoration:none;}
.nav-dot{width:9px;height:9px;border-radius:2px;background:var(--cobalt);transform:rotate(45deg);flex-shrink:0;}
.nav-name{font-family:var(--display);font-weight:600;font-size:0.98rem;letter-spacing:-0.01em;}
.nav-links{display:flex;align-items:center;gap:2.1rem;list-style:none;}
.nav-links a{
  font-family:var(--mono);font-size:0.72rem;text-decoration:none;color:var(--slate);
  padding:0.3rem 0;border-bottom:1px solid transparent;transition:color .15s,border-color .15s;
}
.nav-links a:hover,.nav-links a.active{color:var(--navy);border-color:var(--cobalt);}
.nav-links a.cta{color:var(--white);background:var(--navy);padding:0.5rem 0.95rem;border-radius:3px;border:none;}
.nav-links a.cta:hover{background:var(--cobalt);}

/* BUTTONS */
.btn{
  display:inline-flex;align-items:center;gap:0.5rem;
  padding:0.85rem 1.5rem;border-radius:4px;
  font-family:var(--body);font-weight:600;font-size:0.87rem;
  text-decoration:none;transition:transform .15s,box-shadow .15s,background .15s;
  border:1px solid transparent;cursor:pointer;
}
.btn-primary{background:var(--navy);color:var(--white);}
.btn-primary:hover{background:var(--cobalt);transform:translateY(-2px);box-shadow:0 8px 20px rgba(51,85,255,0.28);}
.btn-ghost{border-color:var(--line);color:var(--navy);background:var(--white);}
.btn-ghost:hover{border-color:var(--navy);transform:translateY(-2px);}

/* SHELL */
.sec{max-width:1160px;margin:0 auto;padding:5.5rem 2.75rem;}
.sec-top{border-top:1px solid var(--line);}
.sec-label{font-family:var(--mono);font-size:0.72rem;color:var(--cobalt);letter-spacing:0.04em;margin-bottom:0.9rem;display:block;}
.sec h2{font-family:var(--display);font-size:clamp(1.7rem,3vw,2.15rem);font-weight:600;letter-spacing:-0.02em;max-width:660px;}
.sec .lede{color:var(--slate);font-size:1rem;line-height:1.75;max-width:620px;margin-top:1.1rem;}

/* PAGE HEADER */
.page-head{max-width:1160px;margin:0 auto;padding:9rem 2.75rem 3rem;}
.page-head h1{
  font-family:var(--display);font-weight:600;
  font-size:clamp(2.3rem,4.6vw,3.5rem);line-height:1.06;letter-spacing:-0.03em;
  margin-bottom:1.3rem;max-width:800px;
}
.page-head .lede{color:var(--slate);font-size:1.08rem;line-height:1.75;max-width:640px;}
.page-head .lede strong{color:var(--navy);font-weight:600;}
.eyebrow{
  display:inline-flex;align-items:center;gap:0.5rem;
  font-family:var(--mono);font-size:0.74rem;color:var(--cobalt);
  background:var(--cobalt-soft);padding:0.4rem 0.75rem;border-radius:3px;margin-bottom:1.6rem;
}
.eyebrow::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--cobalt);animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:0.35;}}

/* FOOTER */
footer{
  max-width:1160px;margin:0 auto;padding:3rem 2.75rem 4rem;border-top:1px solid var(--line);
  display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;
}
footer p{font-family:var(--mono);font-size:0.72rem;color:var(--slate);}
.foot-links{display:flex;gap:1.4rem;}
.foot-links a{font-family:var(--mono);font-size:0.72rem;color:var(--slate);text-decoration:none;}
.foot-links a:hover{color:var(--cobalt);}

/* REVEAL */
[data-reveal]{opacity:0;transform:translateY(16px);transition:opacity .6s ease,transform .6s ease;}
[data-reveal].in{opacity:1;transform:translateY(0);}

@media(max-width:820px){
  nav{padding:1rem 1.4rem;}
  .sec,.page-head,footer{padding-left:1.4rem;padding-right:1.4rem;}
  .page-head{padding-top:7.5rem;}
  .nav-links{gap:1rem;}
  .nav-links a:not(.cta){display:none;}
}
